{
  "name": "iiitn-auth-cli",
  "version": "1.2.2",
  "description": "Automatic authenticator for the IIITN Fortinet captive portal — headless, secure, and daemon-capable.",
  "main": "build/index.js",
  "exports": {
    ".": {
      "require": "./build/index.js",
      "import": "./build/index.js",
      "default": "./build/index.js"
    }
  },
  "sideEffects": false,
  "bin": {
    "iiitn-auth-cli": "build/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-readme.js && node scripts/chmod-bin.js",
    "dev": "ts-node src/index.ts",
    "start": "node build/index.js",
    "clean": "node -e \"const fs=require('fs');const p='build';if(fs.existsSync(p))fs.rmSync(p,{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run rebuild",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --no-error-on-unmatched-pattern --fix",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "iiitn",
    "fortinet",
    "captive-portal",
    "authentication",
    "cli",
    "daemon"
  ],
  "author": "Ojas S.K Mohbansi",
  "license": "MIT",
  "homepage": "https://github.com/ojas-mohbansi/iiitn-auth-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ojas-mohbansi/iiitn-auth-cli.git"
  },
  "bugs": {
    "url": "https://github.com/ojas-mohbansi/iiitn-auth-cli/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "axios-cookiejar-support": "^4.0.7",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "conf": "^10.2.0",
    "inquirer": "^8.2.6",
    "keytar": "^7.9.0",
    "open": "^8.4.2",
    "ora": "^5.4.1",
    "tough-cookie": "^4.1.4",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/tough-cookie": "^4.0.5",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "nock": "^13.5.4",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "files": [
    "build/",
    "scripts/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
