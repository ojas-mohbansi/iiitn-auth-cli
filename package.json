{
  "name": "@ojas-mohbansi/iiitn-auth-cli",
  "version": "1.0.2",
  "description": "CLI tool for IITN AuthBahn authentication (replicates browser extension)",
  "main": "auth.js",
  "bin": {
    "iiitn-auth-cli": "cli.js"
  },
  "scripts": {
    "setup": "node cli.js --setup",
    "start": "node cli.js --start",
    "status": "node cli.js --status",
    "logout": "node cli.js --logout",
    "log": "node cli.js --log"
  },
  "dependencies": {
    "axios": "1.20.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "ojas-mohbansi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ojas-mohbansi/iiitn-auth-cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "iiitn",
    "authbahn",
    "cli",
    "authentication",
    "network"
  ]
}
